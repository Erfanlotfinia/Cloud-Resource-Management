# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# Use localhost hostnames when running the API/workers on the host machine.
# Use Docker service names (postgres, redis, rabbitmq) when running inside Compose.

# Application
APP_NAME=Cloud Resource Management API

# PostgreSQL (matches docker-compose postgres service)
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT authentication (min 16 characters)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Job queue and limits
JOBS_QUEUE_NAME=jobs.execute
JOBS_PER_USER_RUNNING_LIMIT=3
JOBS_CACHE_TTL_SECONDS=30
RATE_LIMIT_PER_MINUTE=10

# Worker job execution
JOB_LEASE_SECONDS=60
JOB_RETRY_BASE_DELAY_SECONDS=5
WORKER_ID=worker-local

# Outbox publisher
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_MAX_RETRIES=12

# Dead-letter queue (RabbitMQ)
JOBS_DEAD_LETTER_EXCHANGE=jobs.dlx
JOBS_DEAD_LETTER_QUEUE=jobs.dead
JOBS_DEAD_LETTER_ROUTING_KEY=jobs.dead

# Required header token for admin registration (local/dev only)
ADMIN_SETUP_TOKEN=local-admin-setup-token
